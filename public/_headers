# Cloudflare Pages / Workers Static Assets — copied to dist/ root on build.
# Hashed Vite bundles are immutable; unhashed atlases/audio/shell must revalidate
# so deploys reach players without clearing site data (IndexedDB saves stay put).

/assets/atlases/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/audio/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/CREDITS.json
  Cache-Control: public, max-age=0, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, must-revalidate

/sw.js
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=86400, must-revalidate

/data/*
  Content-Type: application/json; charset=utf-8
  Cache-Control: public, max-age=0, must-revalidate
